{
  "openapi": "3.1.0",
  "info": {
    "title": "UptimeRobot selected operations",
    "version": "0.2.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.uptimerobot.com/v3"
    }
  ],
  "paths": {
    "/monitors": {
      "get": {
        "operationId": "list_monitors",
        "summary": "List monitors.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999999999
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      },
      "post": {
        "operationId": "create_http_monitor",
        "summary": "Create http monitor.",
        "parameters": [],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "friendlyName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 250,
                    "description": "Value"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 10000
                  },
                  "interval": {
                    "type": "integer",
                    "minimum": 30,
                    "maximum": 86400
                  },
                  "timeout": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 60
                  },
                  "type": {
                    "const": "HTTP",
                    "default": "HTTP"
                  }
                },
                "required": [
                  "friendlyName",
                  "url",
                  "interval",
                  "timeout",
                  "type"
                ]
              }
            }
          }
        }
      }
    },
    "/monitors/{id}": {
      "get": {
        "operationId": "get_monitor",
        "summary": "Get monitor.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999999999
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
